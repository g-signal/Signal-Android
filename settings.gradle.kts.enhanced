pluginManagement {
  repositories {
    google()
    mavenCentral()
    gradlePluginPortal()
  }
  includeBuild("build-logic")
}

dependencyResolutionManagement {
  repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
  repositories {
    google()
    mavenCentral()
    mavenLocal()
    maven {
      url = uri("https://raw.githubusercontent.com/signalapp/maven/master/sqlcipher/release/")
      content {
        includeGroupByRegex("org\\.signal.*")
      }
    }
    maven {
      url = uri("https://raw.githubusercontent.com/signalapp/maven/master/aesgcmprovider/release/")
      content {
        includeGroupByRegex("org\\.signal.*")
      }
    }
    maven {
      url = uri("https://dl.cloudsmith.io/qxAgwaeEE1vN8aLU/mobilecoin/mobilecoin/maven/")
    }
  }
  versionCatalogs {
    create("benchmarkLibs") {
      from(files("gradle/benchmark-libs.versions.toml"))
    }
    create("testLibs") {
      from(files("gradle/test-libs.versions.toml"))
    }
    create("lintLibs") {
      from(files("gradle/lint-libs.versions.toml"))
    }
  }
}

// ==================== libsignal 本地源码集成（增强版） ====================
val libsignalClientPath = if (extra.has("libsignalClientPath")) {
  extra.get("libsignalClientPath") as String?
} else {
  null
}

if (libsignalClientPath != null && libsignalClientPath.isNotBlank()) {
  val libsignalPath = rootDir.resolve(libsignalClientPath + "/java")

  // 验证路径是否存在
  if (!libsignalPath.exists()) {
    logger.error("⚠️  WARNING: libsignal path does not exist: ${libsignalPath.absolutePath}")
    logger.error("⚠️  Please check your gradle.properties configuration.")
    logger.error("⚠️  Signal-Android will try to use Maven repositories instead.")
  } else {
    // 检查必要的子项目
    val clientProject = File(libsignalPath, "client/build.gradle")
    val androidProject = File(libsignalPath, "android/build.gradle")

    if (!clientProject.exists() || !androidProject.exists()) {
      logger.error("⚠️  WARNING: libsignal projects incomplete at: ${libsignalPath.absolutePath}")
      logger.error("⚠️  Missing client or android subproject.")
    } else {
      // 检查 .so 文件是否已构建
      val jniLibs = File(libsignalPath, "android/src/main/jniLibs")
      val hasNativeLibs = jniLibs.exists() && jniLibs.listFiles()?.isNotEmpty() == true

      println("\n" + "=".repeat(70))
      println("📦 Using LOCAL libsignal")
      println("=".repeat(70))
      println("Path: ${libsignalPath.absolutePath}")
      println("Native libs (.so): ${if (hasNativeLibs) "✅ Found" else "⚠️  Not found"}")

      if (!hasNativeLibs) {
        println("\n⚠️  WARNING: Native libraries (.so files) not found!")
        println("Please run: cd ${libsignalPath.parent} && ./build_jni.sh android")
        println("Or run: E:\\code\\libsignal\\java\\build_jni.sh android\n")
      } else {
        // 显示已构建的架构
        val architectures = jniLibs.listFiles()?.filter { it.isDirectory }?.map { it.name } ?: emptyList()
        println("Architectures: ${architectures.joinToString(", ")}")
      }
      println("=".repeat(70) + "\n")

      // 包含 composite build
      includeBuild(libsignalPath) {
        name = "libsignal-client"
        dependencySubstitution {
          substitute(module("org.signal:libsignal-client")).using(project(":client"))
          substitute(module("org.signal:libsignal-android")).using(project(":android"))
        }
      }
    }
  }
} else {
  println("\n" + "=".repeat(70))
  println("📦 Using OFFICIAL libsignal from Maven repositories")
  println("=".repeat(70))
  println("To use local libsignal, set in gradle.properties:")
  println("  libsignalClientPath=../libsignal")
  println("  org.gradle.dependency.verification=lenient")
  println("Or run: setup_local_libsignal.bat")
  println("=".repeat(70) + "\n")
}

