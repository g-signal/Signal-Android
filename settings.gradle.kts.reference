/*
 * Signal-Android Settings Configuration
 *
 * 此文件配置项目的依赖管理和模块结构
 * 包含了使用本地 libsignal 源码的智能依赖替换
 */

// ==================== 插件管理 ====================
pluginManagement {
  repositories {
    google()
    mavenCentral()
    gradlePluginPortal()
  }
  // 包含自定义的构建逻辑插件
  includeBuild("build-logic")
}

// ==================== 依赖解析管理 ====================
dependencyResolutionManagement {
  // 禁止项目级别的仓库配置，所有仓库必须在此定义
  repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)

  repositories {
    google()           // Android 官方库
    mavenCentral()     // Maven 中央仓库
    mavenLocal()       // 本地 Maven 仓库

    // Signal 的 SQLCipher 定制版本
    maven {
      url = uri("https://raw.githubusercontent.com/signalapp/maven/master/sqlcipher/release/")
      content {
        includeGroupByRegex("org\\.signal.*")
      }
    }

    // Signal 的 AES-GCM Provider
    maven {
      url = uri("https://raw.githubusercontent.com/signalapp/maven/master/aesgcmprovider/release/")
      content {
        includeGroupByRegex("org\\.signal.*")
      }
    }

    // MobileCoin 库（用于支付功能）
    maven {
      url = uri("https://dl.cloudsmith.io/qxAgwaeEE1vN8aLU/mobilecoin/mobilecoin/maven/")
    }
  }

  // 版本目录配置（管理依赖版本）
  versionCatalogs {
    // libs.versions.toml 会自动注册为 "libs"

    // 性能测试相关依赖
    create("benchmarkLibs") {
      from(files("gradle/benchmark-libs.versions.toml"))
    }

    // 测试相关依赖
    create("testLibs") {
      from(files("gradle/test-libs.versions.toml"))
    }

    // Lint 检查相关依赖
    create("lintLibs") {
      from(files("gradle/lint-libs.versions.toml"))
    }
  }
}

// ==================== libsignal 本地源码集成 ====================
/*
 * 智能依赖替换机制
 *
 * 工作原理：
 * 1. 检查 gradle.properties 中是否设置了 libsignalClientPath
 * 2. 如果设置了，使用 Gradle Composite Build 包含本地 libsignal 项目
 * 3. 自动将所有对 Maven 仓库中 libsignal 的依赖替换为本地源码
 *
 * 启用方法：
 * 在 gradle.properties 中添加：
 *   libsignalClientPath=../libsignal
 *   org.gradle.dependency.verification=lenient
 *
 * 优势：
 * - Java 和 Native 代码自动同步
 * - 支持增量编译
 * - 便于调试
 * - 保证版本兼容性
 */

// 从 gradle.properties 读取 libsignalClientPath 属性
val libsignalClientPath = if (extra.has("libsignalClientPath")) {
  extra.get("libsignalClientPath")
} else {
  null
}

// 如果配置了本地 libsignal 路径，进行依赖替换
if (libsignalClientPath is String) {
  println("📦 Using local libsignal from: $libsignalClientPath")

  // 包含本地 libsignal/java 目录作为 composite build
  includeBuild(rootDir.resolve(libsignalClientPath + "/java")) {
    name = "libsignal-client"

    // 依赖替换配置
    dependencySubstitution {
      // 替换 Java 客户端库
      // 将 Maven: org.signal:libsignal-client
      // 替换为 本地项目: libsignal/java/client
      substitute(module("org.signal:libsignal-client"))
        .using(project(":client"))

      // 替换 Android 客户端库（包含 JNI 绑定）
      // 将 Maven: org.signal:libsignal-android
      // 替换为 本地项目: libsignal/java/android
      //
      // 重要：这个项目包含了：
      // - Java/Kotlin JNI 绑定代码
      // - 编译好的 native 库（.so 文件）位于 src/main/jniLibs/
      substitute(module("org.signal:libsignal-android"))
        .using(project(":android"))
    }
  }
} else {
  println("📦 Using libsignal from Maven repositories")
}

// ==================== 项目模块配置 ====================
// 主应用模块
include(":app")

// 核心库和工具
include(":libsignal-service")      // Signal 协议服务
include(":lintchecks")             // 自定义 Lint 规则
include(":core-util")              // Android 核心工具
include(":core-util-jvm")          // JVM 核心工具
include(":core-ui")                // 核心 UI 组件
include(":glide-config")           // Glide 图片加载配置

// UI 组件库
include(":paging")                 // 分页组件
include(":paging-app")
include(":sticky-header-grid")     // 粘性表头网格
include(":photoview")              // 图片查看器
include(":spinner")                // 下拉选择器
include(":spinner-app")

// 功能模块
include(":device-transfer")        // 设备转移
include(":device-transfer-app")
include(":image-editor")           // 图片编辑器
include(":image-editor-app")
include(":donations")              // 捐赠功能
include(":donations-app")
include(":debuglogs-viewer")       // 调试日志查看器
include(":debuglogs-viewer-app")
include(":contacts")               // 联系人管理
include(":contacts-app")
include(":qr")                     // 二维码
include(":qr-app")
include(":video")                  // 视频处理
include(":video-app")
include(":billing")                // 计费（Google Play）

// 性能测试
include(":benchmark")              // 基准测试
include(":microbenchmark")         // 微基准测试

// ==================== 项目目录映射 ====================
// 主应用名称
project(":app").name = "Signal-Android"

// 映射子模块的实际目录位置
// 格式：project(":模块名").projectDir = file("实际路径")
project(":paging").projectDir = file("paging/lib")
project(":paging-app").projectDir = file("paging/app")

project(":device-transfer").projectDir = file("device-transfer/lib")
project(":device-transfer-app").projectDir = file("device-transfer/app")

project(":image-editor").projectDir = file("image-editor/lib")
project(":image-editor-app").projectDir = file("image-editor/app")

project(":donations").projectDir = file("donations/lib")
project(":donations-app").projectDir = file("donations/app")

project(":debuglogs-viewer").projectDir = file("debuglogs-viewer/lib")
project(":debuglogs-viewer-app").projectDir = file("debuglogs-viewer/app")

project(":spinner").projectDir = file("spinner/lib")
project(":spinner-app").projectDir = file("spinner/app")

project(":contacts").projectDir = file("contacts/lib")
project(":contacts-app").projectDir = file("contacts/app")

project(":qr").projectDir = file("qr/lib")
project(":qr-app").projectDir = file("qr/app")

project(":video").projectDir = file("video/lib")
project(":video-app").projectDir = file("video/app")

// 根项目名称
rootProject.name = "Signal"

/*
 * ==================== 使用说明 ====================
 *
 * 1. 使用官方 libsignal (默认)：
 *    - 不做任何修改
 *    - 或在 gradle.properties 中注释掉 libsignalClientPath
 *
 * 2. 使用本地 libsignal：
 *    a) 在 gradle.properties 中添加：
 *       libsignalClientPath=../libsignal
 *       org.gradle.dependency.verification=lenient
 *
 *    b) 或者运行自动化脚本：
 *       setup_local_libsignal.bat
 *
 *    c) 确保本地 libsignal 已构建：
 *       cd E:\code\libsignal\java
 *       bash build_jni.sh android
 *
 * 3. 验证配置：
 *    ./gradlew projects
 *    查看是否包含 "libsignal-client" composite build
 *
 * 4. 切换回官方版本：
 *    运行 restore_official_libsignal.bat
 *
 * ==================== 故障排查 ====================
 *
 * 问题：构建失败，找不到 libsignal
 * 解决：
 * - 检查 libsignalClientPath 路径是否正确
 * - 确认路径使用正斜杠 / 而不是反斜杠 \
 * - 确认 libsignal/java 目录存在
 *
 * 问题：版本不兼容错误
 * 解决：
 * - 确保 Signal-Android 和 libsignal 版本匹配
 * - 查看两个项目的 git tag/branch 是否对应
 *
 * 问题：native 库加载失败
 * 解决：
 * - 确认 libsignal 的 .so 文件已构建
 * - 检查 libsignal/java/android/src/main/jniLibs/ 目录
 * - 清理构建缓存：./gradlew clean
 */
